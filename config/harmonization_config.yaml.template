# ==========================================================================
# Column Harmonization Configuration — TEMPLATE
# ==========================================================================
# Copy this file to config/harmonization_config.yaml and fill in your values.
# This file defines the domain, target data model, and AI settings for
# the column harmonization workflow.
#
# After editing:  databricks bundle deploy && databricks bundle run Column_Mapping_To_Global_Model
# ==========================================================================

# --- Source context (fed to the LLM when proposing column mappings) --------
source_context:
  # Short domain label shown in logs and prompts
  domain: "<your domain, e.g. Germany motor insurance quarterly reporting>"

  # Identifier stored in control tables to distinguish this source
  source_system: "<your source system, e.g. DE_MOTOR_RAW>"

  # Raw table name — must already exist in your catalog.schema
  source_table: "<your raw table name, e.g. motor_insurance_quarterly_raw>"

  # Full description passed to the LLM. Be specific: the more context the
  # model has, the better the mapping quality. Mention the language of
  # source columns, the business domain, and any naming conventions.
  description: >
    <Describe your source data. Mention the source language, business domain,
    and any naming conventions. Example: Quarterly reporting data from Germany
    motor insurance. Source columns are in German. Target model uses English names.>


# --- Target data model (the "ground truth" the LLM maps into) -------------
# Each column entry is shown to the LLM as a valid mapping target.
# The 'description' field is especially important: it helps the LLM
# distinguish between similarly named columns. Write it for an LLM reader.
target_model:
  table_name: "<your harmonized table name, e.g. motor_insurance_quarterly>"

  columns:
    - name: "<column_name>"
      type: "<SQL type: STRING, INT, BIGINT, DOUBLE, TIMESTAMP, etc.>"
      description: "<Business definition — the LLM reads this to find the best match>"
      examples: ["<example1>", "<example2>"]
      required: true
      semantic_group: "<grouping label, e.g. policy, claims, premium>"

    # Add more columns here. Typically 15-30 columns for a reporting table.
    # Example:
    # - name: policy_id
    #   type: STRING
    #   description: "Unique policy identifier"
    #   examples: ["DE-001-2024", "DE-002-2024"]
    #   required: true
    #   semantic_group: policy


# --- Mandatory source columns ------------------------------------------------
# Source columns that MUST be reviewed (approved or corrected) before the
# workflow proceeds past the review gate (notebook 06). List the local
# column names from your raw table.
mandatory_source_columns:
  - "<local_column_name_1>"
  - "<local_column_name_2>"
  # Add all critical source columns that must be mapped


# --- Semantic fields (optional value translation) ----------------------------
# Target column names eligible for value-level translation (notebook 09).
# E.g., translating German category values to English. Leave empty if not needed.
semantic_fields:
  - "<target_column_name_1>"
  # - "<target_column_name_2>"


# --- AI settings -------------------------------------------------------------
ai:
  default_endpoint: "databricks-gpt-5-2"
  estimated_prompt_tokens_per_column: 800
  estimated_response_tokens_per_column: 200
  estimated_cost_per_1k_tokens_eur: 0.002
